{
  "name": "tree-sitter-super",
  "private": true,
  "description": "Grammaire Tree-sitter des fichiers .super (\u00e9tend celle de TSX).",
  "scripts": {
    "generate": "tree-sitter generate",
    "parse": "tree-sitter parse",
    "check": "find ../../examples ../../packages -type f -name '*.super' -not -path '*/node_modules/*' -not -path '*/.super/*' -not -name errors.super > /tmp/tree-sitter-super-files.txt && tree-sitter parse --quiet --stat --paths /tmp/tree-sitter-super-files.txt"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.24.7",
    "tree-sitter-typescript": "github:zed-industries/tree-sitter-typescript#e2c53597d6a5d9cf7bbe8dccde576fe1e46c5899"
  }
}
